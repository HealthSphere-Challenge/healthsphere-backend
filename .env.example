# Example only. Copy to .env and replace CHANGE_ME locally; never commit real credentials.
HEALTHSPHERE_APP_ENVIRONMENT=development
HEALTHSPHERE_DEBUG=false
HEALTHSPHERE_LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://healthsphere_user:CHANGE_ME@localhost:5432/healthsphere
# Must identify a separately provisioned database and never equal DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://healthsphere_test:CHANGE_ME@localhost:5432/healthsphere_test
# Explicit browser origins only. Wildcard credentialed CORS is rejected.
HEALTHSPHERE_CORS_ORIGINS=["http://localhost:5173"]
HEALTHSPHERE_SESSION_COOKIE_NAME=healthsphere_session
HEALTHSPHERE_SESSION_ABSOLUTE_SECONDS=604800
HEALTHSPHERE_SESSION_IDLE_SECONDS=86400
# Optional override; defaults to true in production and false otherwise.
# HEALTHSPHERE_SESSION_COOKIE_SECURE=true
# Backend-only AI transport. Use the same local secret configured in healthsphere-ai.
HEALTHSPHERE_AI_SERVICE_URL=http://127.0.0.1:8001
HEALTHSPHERE_AI_INTERNAL_TOKEN=CHANGE_ME
HEALTHSPHERE_AI_CONNECT_TIMEOUT_SECONDS=2
HEALTHSPHERE_AI_TIMEOUT_SECONDS=10
HEALTHSPHERE_AGENT_SERVICE_URL=
